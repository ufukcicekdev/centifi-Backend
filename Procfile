# Docker dışı (ör. yerel): gömülü Celery için RUN_CELERY_IN_WEB=1 ve broker URL gerekir.
# Worker varsayılanı solo (düşük RAM); docker-entrypoint.sh ile aynı mantık: CELERY_WORKER_POOL / CONCURRENCY.
web: sh -c 'if [ "${RUN_CELERY_IN_WEB:-}" = "1" ] && [ -n "${CELERY_BROKER_URL:-${REDIS_URL:-}}" ]; then POOL="${CELERY_WORKER_POOL:-solo}"; CONC="${CELERY_WORKER_CONCURRENCY:-1}"; if [ "$POOL" = "solo" ]; then celery -A core worker -l info -P solo &; else celery -A core worker -l info -P "$POOL" --concurrency "$CONC" &; fi; celery -A core beat -l info &; fi; exec gunicorn core.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 2 --threads 2 --timeout 120 --graceful-timeout 60 --access-logfile - --error-logfile -'
